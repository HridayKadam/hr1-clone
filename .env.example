# Port the server listens on
PORT=4000
# Where the SQLite database and uploaded files are stored (back this folder up!)
DATA_DIR=./data
# Secret used to sign login sessions. If unset, one is generated and stored in the database.
JWT_SECRET=change-me-to-a-long-random-string
# Set to 1 when serving over HTTPS so session cookies are marked Secure
COOKIE_SECURE=0
# Timezone used for "today", clock-in times and attendance
TZ_NAME=Asia/Kolkata
